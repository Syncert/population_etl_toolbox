{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://population-etl.example/schemas/metric-definition.json",
  "title": "Reviewed metric definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id",
    "name",
    "definition",
    "intended_use",
    "limitations",
    "status",
    "owner",
    "reviewer",
    "version",
    "effective_date",
    "last_reviewed_date",
    "citations"
  ],
  "properties": {
    "metric_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "comparison_guidance": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "approved", "deprecated", "needs_review"]},
    "owner": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "effective_date": {"type": "string", "format": "date"},
    "last_reviewed_date": {"type": "string", "format": "date"},
    "citations": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "minItems": 1
    }
  }
}
