    "start": "next start -p 3100"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "maplibre-gl": "^4.7.1",
    "next": "^14.2.5",
    "pbf": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
