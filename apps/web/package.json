{
  "name": "population-etl-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['.next','.next-dev'].forEach((d)=>fs.rmSync(d,{recursive:true,force:true}))\"",
