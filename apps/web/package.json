{
  "name": "population-etl-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['.next','.next-dev'].forEach((d)=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "dev": "next dev -p 3100",
    "dev:reset": "npm run clean && next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run --config vitest.config.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "next": "15.5.21",
    "pbf": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.21",
    "jsdom": "26.1.0",
    "vitest": "3.2.7"
  }
}
