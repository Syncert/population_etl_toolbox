AIRFLOW__CORE__DAGS_FOLDER=/opt/data_ingestion_toolbox/dags
PYTHONPATH=/opt/data_ingestion_toolbox/src:/opt/data_ingestion_toolbox
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Keeps provider API keys (Census key=, EIA/FRED api_key=) out of task logs:
# quiets httpx request logging and masks secrets on every handler.
AIRFLOW__LOGGING__LOGGING_CONFIG_CLASS=data_ingestion_toolbox.airflow_logging.LOGGING_CONFIG
