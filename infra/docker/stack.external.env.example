# Point these to your existing homelab analytics Postgres host.
ANALYTICS_DB_HOST=your-analytics-postgres-host
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_USER=your_analytics_user
ANALYTICS_DB_PASSWORD=your_analytics_password
ANALYTICS_DB_NAME=your_analytics_db

# Recommended: provision this role with sql/bootstrap/001_api_readonly.sql.
# If omitted, Compose falls back to ANALYTICS_DB_USER for compatibility.
ANALYTICS_API_DB_USER=your_readonly_api_user
ANALYTICS_API_DB_PASSWORD=your_readonly_api_password
API_CACHE_TTL_SECONDS=300
WEB_BIND_ADDRESS=0.0.0.0
WEB_HOST_PORT=3001

# Point these to your existing homelab Airflow metadata Postgres host.
AIRFLOW_METADATA_DB_HOST=your-airflow-metadata-postgres-host
AIRFLOW_METADATA_DB_PORT=5432
AIRFLOW_METADATA_DB_USER=your_airflow_user
AIRFLOW_METADATA_DB_PASSWORD=your_airflow_password
AIRFLOW_METADATA_DB_NAME=your_airflow_db

# Optional override for the Airflow public_data connection.
# If left aligned with ANALYTICS_DB_* values, Airflow writes to analytics DB.
PUBLIC_DATA_DB_HOST=your-analytics-postgres-host
PUBLIC_DATA_DB_PORT=5432
PUBLIC_DATA_DB_USER=your_analytics_user
PUBLIC_DATA_DB_PASSWORD=your_analytics_password
PUBLIC_DATA_DB_NAME=your_analytics_db

# Optional public-read Socrata app token. Keep the real value outside Git.
CDC_SOCRATA_APP_TOKEN=
USDA_NASS_API_KEY=

# Shared signing key for Airflow webserver/scheduler log serving; set one
# stable random value per deployment.
AIRFLOW_WEBSERVER_SECRET_KEY=
