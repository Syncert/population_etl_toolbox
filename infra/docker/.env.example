AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=replace-me
AIRFLOW__WEBSERVER__SECRET_KEY=replace-me
