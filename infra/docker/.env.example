# Host-specific PostgreSQL tuning for the analytics warehouse.
#
# Copy to `infra/docker/.env` and set values for the machine. Compose reads that
# file automatically; it is gitignored because the right numbers depend entirely
# on how much memory the host will give the container.
#
# Why this exists: the defaults in docker-compose.yml are sized so the stack
# starts on a development laptop with about 16 GB to spare. They are not
# adequate for a full serving re-serve. gold_census.rpt_acs_observations alone
# is 66 GB (37 GB heap, 25 GB indexes); at 16 GB of shared_buffers a forced
# re-serve ran at a 59.8% heap cache hit ratio, reading roughly 1.2 TB off disk,
# and averaged about 500 rows per second. At 48 GB the same work sustained
# 3,100 to 4,000 rows per second. See docs/reference/BETA_RESET_REINGESTION.md
# section 7 for the full per-year measurements.
#
# Rules of thumb:
#   shared_buffers        25-40% of the memory the container may actually use.
#                         Postgres will not start if this exceeds what it can
#                         map, and on a warehouse it is the setting that matters
#                         most -- aim to fit the largest serving relation.
#   effective_cache_size  roughly 75% of host memory. This is an estimate the
#                         planner uses, not an allocation.
#   work_mem              per sort/hash node, and a query can use several at
#                         once. Multiply by expected concurrency before raising.
#
# On Docker Desktop with WSL2, the container cannot see more memory than the
# WSL2 VM is given, which defaults to about half of host RAM regardless of
# Docker's own settings. Set it in %USERPROFILE%\.wslconfig:
#
#   [wsl2]
#   memory=96GB
#   processors=32
#   autoMemoryReclaim=gradual
#
# `memory` is a ceiling, not a reservation. Verify what actually took effect
# with `SHOW shared_buffers;` against the running container -- the compose
# `command:` block overrides anything applied with ALTER SYSTEM, so hand-tuning
# at the server is discarded on the next recreate.

# --- Values below are the committed compose defaults (a ~16 GB dev host). ---
# --- Raise them to suit the machine; the commented values are what a       ---
# --- 128 GB workstation used to produce the measurements above.            ---

ANALYTICS_PG_SHARED_BUFFERS=4GB
# ANALYTICS_PG_SHARED_BUFFERS=48GB
ANALYTICS_PG_EFFECTIVE_CACHE_SIZE=12GB
# ANALYTICS_PG_EFFECTIVE_CACHE_SIZE=90GB
ANALYTICS_PG_MAINTENANCE_WORK_MEM=1GB
# ANALYTICS_PG_MAINTENANCE_WORK_MEM=8GB
ANALYTICS_PG_WORK_MEM=64MB
# ANALYTICS_PG_WORK_MEM=512MB

# Write-ahead log. A re-serve rewrites whole years, so small WAL segments mean
# constant checkpointing; 32GB kept checkpoints out of the way on the tuned run.
ANALYTICS_PG_MAX_WAL_SIZE=8GB
# ANALYTICS_PG_MAX_WAL_SIZE=32GB
ANALYTICS_PG_MIN_WAL_SIZE=1GB
# ANALYTICS_PG_MIN_WAL_SIZE=2GB
ANALYTICS_PG_WAL_BUFFERS=64MB
# ANALYTICS_PG_WAL_BUFFERS=128MB
ANALYTICS_PG_CHECKPOINT_TIMEOUT=15min

# Parallelism. Keep max_worker_processes at or above max_parallel_workers.
ANALYTICS_PG_MAX_WORKER_PROCESSES=8
# ANALYTICS_PG_MAX_WORKER_PROCESSES=32
ANALYTICS_PG_MAX_PARALLEL_WORKERS=8
# ANALYTICS_PG_MAX_PARALLEL_WORKERS=32
ANALYTICS_PG_MAX_PARALLEL_PER_GATHER=4
# ANALYTICS_PG_MAX_PARALLEL_PER_GATHER=8
ANALYTICS_PG_MAX_PARALLEL_MAINTENANCE=4
# ANALYTICS_PG_MAX_PARALLEL_MAINTENANCE=8

# Storage shape. Both defaults assume SSD/NVMe; raise random_page_cost toward
# 4.0 only on spinning disks.
ANALYTICS_PG_RANDOM_PAGE_COST=1.1
ANALYTICS_PG_EFFECTIVE_IO_CONCURRENCY=200
