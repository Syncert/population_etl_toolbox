API_ENV=development
API_LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000
USE_MOCK_DATA=false
DATABASE_URL=postgresql://postgres:postgres@analytics_postgres:5432/population_etl
