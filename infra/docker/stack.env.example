ANALYTICS_DB_HOST=analytics_postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics
ANALYTICS_DB_NAME=population_etl

# Read-only credentials used only by the public API and Martin.
ANALYTICS_API_DB_USER=api_reader
ANALYTICS_API_DB_PASSWORD=api_reader
API_CACHE_TTL_SECONDS=300
WEB_BIND_ADDRESS=0.0.0.0
WEB_HOST_PORT=3001

AIRFLOW_METADATA_DB_HOST=service_postgres
AIRFLOW_METADATA_DB_PORT=5432
AIRFLOW_METADATA_DB_USER=airflow
AIRFLOW_METADATA_DB_PASSWORD=airflow
AIRFLOW_METADATA_DB_NAME=airflow

PUBLIC_DATA_DB_HOST=analytics_postgres
PUBLIC_DATA_DB_PORT=5432
PUBLIC_DATA_DB_USER=analytics
PUBLIC_DATA_DB_PASSWORD=analytics
PUBLIC_DATA_DB_NAME=population_etl

# Source API credentials for ingestion DAGs. Keep real values outside Git.
CENSUS_API_KEY=
BLS_API_KEY=
FRED_API_KEY=
FBI_CDE_API_KEY=
USDA_NASS_API_KEY=
# Optional public-read Socrata app token (CDC reads anonymously without it).
CDC_SOCRATA_APP_TOKEN=

# Shared signing key for Airflow webserver/scheduler log serving; set one
# stable random value per deployment.
AIRFLOW_WEBSERVER_SECRET_KEY=
